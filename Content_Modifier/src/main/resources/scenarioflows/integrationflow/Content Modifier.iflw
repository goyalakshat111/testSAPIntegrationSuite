        <bpmn2:callActivity id="CallActivity_7" name="Set Payload">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>constant</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;expression&lt;/cell&gt;&lt;cell id='Value'&gt;${date:now:yyyyMMdd}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;date&lt;/cell&gt;&lt;cell id='Datatype'&gt;java.lang.String&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;akshat&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;name&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;expression&lt;/cell&gt;&lt;cell id='Value'&gt;${date:now:HHmmss}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;time&lt;/cell&gt;&lt;cell id='Datatype'&gt;java.lang.String&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;cpi&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;course&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;Order&gt;
    &lt;OrderID&gt;ORD-10001&lt;/OrderID&gt;
    &lt;OrderDate&gt;2026-09-16&lt;/OrderDate&gt;
    &lt;Status&gt;1&lt;/Status&gt;
    &lt;Customer&gt;
        &lt;CustomerID&gt;CUST-5001&lt;/CustomerID&gt;
        &lt;Name&gt;John Smith&lt;/Name&gt;
        &lt;Email&gt;john.smith@example.com&lt;/Email&gt;
        &lt;Phone&gt;+1-555-0100&lt;/Phone&gt;
    &lt;/Customer&gt;
    &lt;ShippingAddress&gt;
        &lt;Street&gt;125 Market Street&lt;/Street&gt;
        &lt;City&gt;San Francisco&lt;/City&gt;
        &lt;State&gt;CA&lt;/State&gt;
        &lt;PostalCode&gt;94105&lt;/PostalCode&gt;
        &lt;Country&gt;US&lt;/Country&gt;
    &lt;/ShippingAddress&gt;

    &lt;Items&gt;
        &lt;Item&gt;
            &lt;LineNumber&gt;1&lt;/LineNumber&gt;
            &lt;ProductID&gt;PROD-101&lt;/ProductID&gt;
            &lt;Description&gt;Wireless Keyboard&lt;/Description&gt;
            &lt;Quantity&gt;2&lt;/Quantity&gt;
            &lt;UnitPrice currency="USD"&gt;45.00&lt;/UnitPrice&gt;
            &lt;LineTotal currency="USD"&gt;90.00&lt;/LineTotal&gt;
        &lt;/Item&gt;
        &lt;Item&gt;
            &lt;LineNumber&gt;2&lt;/LineNumber&gt;
            &lt;ProductID&gt;PROD-205&lt;/ProductID&gt;
            &lt;Description&gt;USB-C Mouse&lt;/Description&gt;
            &lt;Quantity&gt;1&lt;/Quantity&gt;
            &lt;UnitPrice currency="USD"&gt;25.00&lt;/UnitPrice&gt;
            &lt;LineTotal currency="USD"&gt;25.00&lt;/LineTotal&gt;
        &lt;/Item&gt;
    &lt;/Items&gt;
    &lt;Payment&gt;
        &lt;Method&gt;CreditCard&lt;/Method&gt;
        &lt;PaymentStatus&gt;Authorized&lt;/PaymentStatus&gt;
    &lt;/Payment&gt;
    &lt;Subtotal currency="USD"&gt;115.00&lt;/Subtotal&gt;
    &lt;Tax currency="USD"&gt;9.20&lt;/Tax&gt;
    &lt;ShippingCost currency="USD"&gt;5.00&lt;/ShippingCost&gt;
    &lt;TotalAmount currency="USD"&gt;129.20&lt;/TotalAmount&gt;
&lt;/Order&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
                </ifl:property>
                <ifl:property>
                    <key>activityType</key>
                    <value>Enricher</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::Enricher/version::1.6.5</value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>SequenceFlow_8</bpmn2:incoming>
            <bpmn2:outgoing>SequenceFlow_9</bpmn2:outgoing>
        </bpmn2:callActivity>
        <bpmn2:callActivity id="CallActivity_12" name="Property">
            <bpmn2:extensionElements>
                <ifl:property>
